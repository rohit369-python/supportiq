# ============================================================
# SupportIQ Environment Configuration
# Copy this file to .env and fill in values
# ============================================================

# Application
APP_NAME=SupportIQ
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (primary database + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq_secret
POSTGRES_DB=supportiq
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq_secret@localhost:5432/supportiq
DATABASE_URL_SYNC=postgresql://supportiq:supportiq_secret@localhost:5432/supportiq

# MongoDB (flexible documents / webhook payloads)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=supportiq_events
MONGO_URL=mongodb://localhost:27017/supportiq_events

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-to-something-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / LLM Provider (OpenAI-compatible)
LLM_PROVIDER=mock
# For real OpenAI or compatible:
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding / RAG
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.html

# Email (mock by default)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@supportiq.local

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20

# Observability
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Multi-tenancy / Security
ENABLE_TENANT_ISOLATION=true
DEFAULT_ORGANIZATION_SLUG=demo-ecommerce

# Seed / Demo
SEED_DEMO_DATA=true